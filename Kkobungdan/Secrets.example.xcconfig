// Secrets.example.xcconfig
//
// 이 파일을 복사해 `Secrets.Debug.xcconfig`, `Secrets.Release.xcconfig` 로 저장한 뒤
// 실제 키 값을 채워 넣으세요.
// `Secrets.*.xcconfig` 는 .gitignore 에 등록되어 있어 커밋되지 않습니다.
//
// Xcode 연결 방법:
//   1. Project(타겟 아님) → Info → Configurations
//   2. Debug 에는 `Secrets.Debug`, Release 에는 `Secrets.Release` 선택
//   3. xcconfig 파일은 Target Membership 체크 해제 (앱 번들에 포함되지 않게)

// 카카오 개발자 콘솔의 네이티브 앱 키
KAKAO_NATIVE_APP_KEY = 00000000000000000000000000000000

// 앱이 사용하는 백엔드 API 베이스 호스트 (scheme 제외). 예: api.example.com, 0.0.0.0
// xcconfig 에서 `//` 는 주석이므로 스킴은 API_BASE_SCHEME 로 따로 둔다.
API_BASE_SCHEME = https
API_BASE_HOST = 0.0.0.0

// DTO 계약 테스트(Scripts/sync-openapi.py)가 스펙을 받아오는 개발/테스트 서버 호스트.
DEV_API_BASE_HOST = 0.0.0.0

// 스테이징 docs/openapi.json 은 Basic 인증으로 보호되어 있다. 계약 테스트 스크립트가
// 이 값으로 인증한다. (CI 에서는 환경변수 OPENAPI_USER / OPENAPI_PASSWORD 로 대체 가능)
DEV_API_DOCS_USER = username
DEV_API_DOCS_PASSWORD = password
