<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>꼬붕단</string>
	<key>UIAppFonts</key>
	<array>
		<string>Pretendard-Thin.ttf</string>
		<string>Pretendard-ExtraLight.ttf</string>
		<string>Pretendard-Light.ttf</string>
		<string>Pretendard-Regular.ttf</string>
		<string>Pretendard-Medium.ttf</string>
		<string>Pretendard-SemiBold.ttf</string>
		<string>Pretendard-Bold.ttf</string>
		<string>Pretendard-ExtraBold.ttf</string>
		<string>Pretendard-Black.ttf</string>
	</array>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>kakaokompassauth</string>
		<string>storykompassauth</string>
		<string>kakaolink</string>
	</array>
	<key>CFBundleURLTypes</key>
	<array>
    	<dict>
        	<key>CFBundleURLSchemes</key>
        	<array>
            	<string>kakao$(KAKAO_NATIVE_APP_KEY)</string>
        	</array>
    	</dict>
</array>
	<key>KAKAO_NATIVE_APP_KEY</key>
	<string>$(KAKAO_NATIVE_APP_KEY)</string>
	<key>API_BASE_HOST</key>
	<string>$(API_BASE_HOST)</string>
	<!--
	  개발 단계 한정: 백엔드가 아직 HTTP 라서 전역 ATS 우회를 켠다.
	  운영 전 반드시 false 로 되돌리고 NSExceptionDomains 로 좁히거나 서버를 HTTPS 화할 것.
	-->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
</dict>
</plist>
