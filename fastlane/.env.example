# 로컬에서 `bundle exec fastlane setup_signing` 을 돌릴 때 쓰는 환경변수.
# 이 파일을 fastlane/.env 로 복사해 값을 채운다. (fastlane/.env 는 gitignore — 커밋하지 않는다)
# CI 에서는 같은 이름의 GitHub Secrets 를 쓴다.

# App Store Connect API Key (사용자 및 액세스 → 통합 → App Store Connect API, 권한: App Manager 이상)
ASC_KEY_ID=
ASC_ISSUER_ID=
# AuthKey_XXXX.p8 파일을 base64 로: base64 -i AuthKey_XXXX.p8
ASC_KEY_P8=

# match 인증서 저장소 (private git 저장소)
MATCH_GIT_URL=
# 인증서·프로필 암호화 암호. 최초 setup_signing 때 정한 값을 CI 에도 똑같이 넣는다.
MATCH_PASSWORD=
# HTTPS 저장소 인증: echo -n "github아이디:PAT" | base64  (SSH URL 을 쓰면 비워둔다)
MATCH_GIT_BASIC_AUTHORIZATION=
