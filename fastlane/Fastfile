# Kkobungdan iOS 배포 lane
#
#   bundle exec fastlane beta                 # Staging 구성(스테이징 API) → TestFlight 외부 테스트
#   bundle exec fastlane release tag:v1.2.3   # Release 구성(운영 API)   → App Store 심사 제출
#   bundle exec fastlane setup_signing        # [로컬] match 인증서·프로필 생성 (이미 있으면 불필요)
#
# beta / release 는 CI(GitHub Actions) 전용이다. 서명을 match 프로필로 바꾸려고
# project.pbxproj 를 수정하므로, 로컬에서 돌리면 작업 트리가 더러워진다.
# 로컬에서 꼭 돌려야 하면 FASTLANE_ALLOW_LOCAL=1 을 주고, 끝난 뒤 pbxproj 변경을 되돌린다.
#
# 필요한 환경변수
#   ASC_KEY_ID / ASC_ISSUER_ID / ASC_KEY_P8(base64)   App Store Connect API Key
#   MATCH_GIT_URL / MATCH_PASSWORD / MATCH_GIT_BASIC_AUTHORIZATION
# 선택 (비우면 App Store Connect 의 TestFlight "테스트 정보" 에 저장된 값을 그대로 쓴다)
#   BETA_CONTACT_EMAIL / BETA_CONTACT_FIRST_NAME / BETA_CONTACT_LAST_NAME / BETA_CONTACT_PHONE
#   BETA_DEMO_ACCOUNT_NAME / BETA_DEMO_ACCOUNT_PASSWORD / BETA_REVIEW_NOTES

require "json"
require "tmpdir"

default_platform(:ios)

# Staging · Release 모두 같은 Bundle ID = 같은 App Store Connect 앱 레코드 · 같은 match 프로필.
#   Staging : 꼬붕단 STG (스테이징 API) → 이 앱의 TestFlight 외부 테스트 그룹
#   Release : 꼬붕단     (운영 API)     → 이 앱의 App Store 출시
# 서버는 빌드 구성(Secrets.<구성>.xcconfig)으로만 갈린다.
APP_ID = "com.kkobungdan.Kkobungdan"
TEAM_ID = "6AW4DY5F93"
PROJECT = "Kkobungdan.xcodeproj"
SCHEME = "Kkobungdan"
APP_TARGET = "Kkobungdan"
OUTPUT_DIR = "build/fastlane"
SOURCE_PACKAGES_DIR = "build/SourcePackages"

EXTERNAL_TEST_GROUPS = ["external_app_tester"].freeze
RELEASE_BRANCH = "origin/main"
STAGING_NAME_MARKER = "STG"
# App Store Connect buildBetaDetail.externalBuildState 중 "아직 심사가 끝나지 않은" 상태
BETA_REVIEW_PENDING_STATES = ["WAITING_FOR_BETA_REVIEW", "IN_BETA_REVIEW"].freeze

platform :ios do
  before_all do
    setup_ci if is_ci
  end

  desc "유닛 테스트 (KkobungdanTests)"
  lane :test do
    run_tests(
      project: PROJECT,
      scheme: SCHEME,
      device: ENV.fetch("TEST_DEVICE", "iPhone 17"),
      only_testing: ["KkobungdanTests"],
      cloned_source_packages_path: SOURCE_PACKAGES_DIR,
      result_bundle: true,
      output_directory: "#{OUTPUT_DIR}/test"
    )
  end

  desc "Staging 구성(스테이징 API)으로 빌드해 TestFlight 외부 테스트 그룹에 배포 (Beta App Review 자동 제출)"
  lane :beta do
    ensure_ci_or_allowed!
    api_key = asc_api_key
    ensure_version_train_open(api_key: api_key)

    build_number = next_build_number(api_key: api_key)
    ipa = build_signed_ipa(configuration: "Staging", build_number: build_number, api_key: api_key)
    verify_ipa!(ipa, configuration: "Staging")

    # 같은 버전의 빌드는 한 번에 하나만 Beta App Review 에 올릴 수 있다.
    # 이전 빌드가 심사 대기/심사 중이면 업로드만 하고 제출은 건너뛴다. (실패 대신 경고)
    version = get_version_string
    reviewing = builds_in_beta_review(api_key: api_key, version: version)
    unless reviewing.empty?
      upload_to_testflight(
        api_key: api_key,
        app_identifier: APP_ID,
        ipa: ipa,
        skip_submission: true,
        skip_waiting_for_build_processing: true
      )
      message = "#{version} 의 빌드 #{reviewing.join(', ')} 가 Beta App Review 중이라 빌드 #{build_number} 는 업로드만 했습니다. " \
                "심사가 끝난 뒤 staging 에 다시 머지하거나 이 워크플로를 수동 실행하면 외부 테스트로 배포됩니다."
      UI.important(message)
      puts("::warning::#{message}") if ENV["GITHUB_ACTIONS"]
      next
    end

    # 외부 테스트는 빌드 처리가 끝나야 그룹 추가·심사 제출이 가능하므로 처리 완료까지 기다린다.
    # 심사 제출 후 Apple 승인(보통 수 시간~1일)은 기다리지 않는다. 그룹이 미리 지정되어 있어
    # 승인되는 즉시 external_app_tester 에 배포되고 외부 테스터에게 알림이 간다.
    # (같은 버전의 후속 빌드는 Apple 이 심사 없이 바로 승인하는 경우가 많다)
    upload_to_testflight(
      {
        api_key: api_key,
        app_identifier: APP_ID,
        ipa: ipa,
        skip_waiting_for_build_processing: false,
        distribute_external: true,
        groups: EXTERNAL_TEST_GROUPS,
        submit_beta_review: true,
        notify_external_testers: true,
        uses_non_exempt_encryption: false,
        changelog: staging_changelog
      }.merge(beta_review_info_options)
    )

    UI.success("TestFlight 외부 테스트 제출 완료: #{version} (#{build_number}) → #{EXTERNAL_TEST_GROUPS.join(', ')}")
  end

  desc "Release 구성(운영 API)으로 빌드해 App Store 심사 제출 (출시는 App Store Connect 에서 수동)"
  lane :release do |options|
    ensure_ci_or_allowed!

    version = get_version_string
    tag = options[:tag] || ENV["RELEASE_TAG"]
    ensure_release_ref!(tag: tag, version: version)

    api_key = asc_api_key
    ensure_version_train_open(api_key: api_key)

    build_number = next_build_number(api_key: api_key)
    ipa = build_signed_ipa(configuration: "Release", build_number: build_number, api_key: api_key)
    verify_ipa!(ipa, configuration: "Release")

    # 1) 업로드 + 처리 완료 대기만 한다. (TestFlight 그룹 배포·베타 심사 제출 없음)
    upload_to_testflight(
      api_key: api_key,
      app_identifier: APP_ID,
      ipa: ipa,
      skip_submission: true,
      skip_waiting_for_build_processing: false,
      uses_non_exempt_encryption: false
    )

    # 2) build_number 를 명시해, 같은 버전으로 TestFlight 에 올라가 있는 Staging 빌드가
    #    심사 대상으로 선택될 여지를 없앤다. (방금 검증·업로드한 빌드만 제출)
    #    deliver 는 build_number 와 ipa 를 함께 받지 않으므로 바이너리 업로드는 1) 에서 끝낸다.
    upload_to_app_store(
      api_key: api_key,
      app_identifier: APP_ID,
      app_version: version,
      build_number: build_number.to_s,
      skip_binary_upload: true,
      skip_metadata: true,
      skip_screenshots: true,
      submit_for_review: true,
      automatic_release: false,
      force: true,
      run_precheck_before_submit: false
    )

    UI.success("App Store 심사 제출 완료: #{version} (#{build_number})")
  end

  desc "[로컬] match 저장소에 Distribution 인증서 + App Store 프로필 생성 (mobile-signing 에 이미 있으면 불필요)"
  lane :setup_signing do
    UI.user_error!("setup_signing 은 로컬에서만 실행합니다. CI 는 readonly 로 가져오기만 한다.") if is_ci
    api_key = asc_api_key

    # 이미 있으면 재사용하고, 없을 때만 Apple Developer 에 생성한다.
    # App ID 의 Capability(Push · Sign in with Apple)를 바꾼 뒤에는 force: true 로 프로필을 다시 만든다.
    match(
      type: "appstore",
      app_identifier: [APP_ID],
      readonly: false,
      api_key: api_key
    )
  end

  # ── helpers ────────────────────────────────────────────

  private_lane :asc_api_key do
    app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_P8"),
      is_key_content_base64: true
    )
  end

  # TestFlight(Staging)·App Store(Release)가 같은 앱 레코드라 빌드 번호를 공유한다.
  # 업로드된 최신 번호 / 저장소 번호 중 큰 값 + 1 을 쓰고, 저장소에 다시 커밋하지 않는다.
  private_lane :next_build_number do |options|
    uploaded = latest_testflight_build_number(
      api_key: options[:api_key],
      app_identifier: APP_ID,
      initial_build_number: 0
    ).to_i
    in_repo = project_build_setting("CURRENT_PROJECT_VERSION").to_i
    [uploaded, in_repo].max + 1
  end

  # 이미 App Store 에 출시된 버전(train)에는 새 빌드를 올릴 수 없다.
  # 업로드 실패를 빌드 후에야 알지 않도록, 빌드 전에 MARKETING_VERSION 이 출시 버전보다 큰지 확인한다.
  private_lane :ensure_version_train_open do |options|
    version = get_version_string
    app_store_build_number(api_key: options[:api_key], app_identifier: APP_ID, live: true)
    live_version = lane_context[SharedValues::LATEST_VERSION].to_s
    next if live_version.empty?

    if Gem::Version.new(version) <= Gem::Version.new(live_version)
      UI.user_error!(
        "MARKETING_VERSION(#{version})이 App Store 출시 버전(#{live_version}) 이하입니다. " \
        "출시된 버전에는 빌드를 올릴 수 없으니 dev 에서 버전을 올린 뒤 다시 배포하세요."
      )
    end
  end

  # 해당 버전에서 외부 테스트 심사 대기/심사 중인 빌드 번호 목록
  private_lane :builds_in_beta_review do |options|
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.from(hash: options[:api_key])
    app = Spaceship::ConnectAPI::App.find(APP_ID)
    UI.user_error!("App Store Connect 에서 #{APP_ID} 앱을 찾지 못했습니다.") unless app

    Spaceship::ConnectAPI::Build.all(app_id: app.id, version: options[:version], limit: 50)
                                .select { |build| BETA_REVIEW_PENDING_STATES.include?(build.build_beta_detail&.external_build_state) }
                                .map(&:version)
  end

  private_lane :build_signed_ipa do |options|
    configuration = options[:configuration]

    # mobile-signing 저장소의 기존 App Store 인증서·프로필을 읽기 전용으로 가져온다. (새로 만들지 않음)
    match(type: "appstore", app_identifier: [APP_ID], readonly: true, api_key: options[:api_key])
    profile_name = lane_context[SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING][APP_ID]

    # 앱 타깃의 해당 구성만 수동 서명 + match 프로필로 전환 (SPM 패키지는 건드리지 않는다)
    update_code_signing_settings(
      path: PROJECT,
      use_automatic_signing: false,
      targets: [APP_TARGET],
      build_configurations: [configuration],
      team_id: TEAM_ID,
      code_sign_identity: "Apple Distribution",
      profile_name: profile_name
    )

    build_app(
      project: PROJECT,
      scheme: SCHEME,
      configuration: configuration,
      export_method: "app-store",
      export_options: { provisioningProfiles: { APP_ID => profile_name } },
      cloned_source_packages_path: SOURCE_PACKAGES_DIR,
      disable_package_automatic_updates: true,
      xcargs: "CURRENT_PROJECT_VERSION=#{options[:build_number]}",
      output_directory: OUTPUT_DIR,
      output_name: "Kkobungdan-#{configuration}.ipa",
      buildlog_path: "#{OUTPUT_DIR}/logs",
      clean: true
    )
  end
end

# ── 검증 ──────────────────────────────────────────────────

def ensure_ci_or_allowed!
  return if is_ci || ENV["FASTLANE_ALLOW_LOCAL"] == "1"

  UI.user_error!("beta / release 는 CI 전용입니다. (로컬 실행: FASTLANE_ALLOW_LOCAL=1, 끝난 뒤 pbxproj 변경 되돌리기)")
end

# Release 는 main 에 머지된 커밋의 vX.Y.Z 태그에서만 빌드한다.
def ensure_release_ref!(tag:, version:)
  UI.user_error!("릴리스 태그가 필요합니다. 예: fastlane release tag:v#{version}") if tag.to_s.empty?
  UI.user_error!("태그(#{tag})와 MARKETING_VERSION(#{version})이 다릅니다.") unless tag == "v#{version}"

  tag_commit = git_output("rev-list", "-n", "1", tag)
  UI.user_error!("태그 #{tag} 를 찾을 수 없습니다. (checkout 에 fetch-depth: 0 필요)") if tag_commit.empty?
  head = git_output("rev-parse", "HEAD")
  UI.user_error!("HEAD(#{head[0, 7]})가 태그 #{tag}(#{tag_commit[0, 7]}) 커밋이 아닙니다.") unless head == tag_commit
  unless system("git", "merge-base", "--is-ancestor", tag_commit, RELEASE_BRANCH)
    UI.user_error!("태그 #{tag} 커밋이 #{RELEASE_BRANCH} 에 머지되어 있지 않습니다. staging 등 다른 브랜치의 커밋은 출시할 수 없습니다.")
  end
end

# 업로드 직전, 실제로 만들어진 IPA 의 Info.plist 로 빌드 구성·서버·앱 이름을 확인한다.
#   Staging : 구성=Staging · 스테이징 API · 앱 이름에 STG
#   Release : 구성=Release · 운영 API(스테이징 호스트 아님) · 앱 이름에 STG 없음
# 호스트 값은 로그에 남기지 않는다.
def verify_ipa!(ipa, configuration:)
  info = ipa_info_plist(ipa)
  fail_ipa = ->(reason) { UI.user_error!("IPA 검증 실패(#{configuration}): #{reason} — 업로드하지 않습니다.") }

  fail_ipa.call("Bundle ID 가 #{APP_ID} 가 아닙니다.") unless info["CFBundleIdentifier"] == APP_ID
  built_with = info["APP_BUILD_CONFIGURATION"]
  fail_ipa.call("#{built_with.inspect} 구성으로 빌드된 IPA 입니다.") unless built_with == configuration

  expected_host = xcconfig_value(configuration, "API_BASE_HOST")
  fail_ipa.call("API_BASE_HOST 가 Secrets.#{configuration}.xcconfig 값과 다릅니다.") unless info["API_BASE_HOST"] == expected_host

  display_name = info["CFBundleDisplayName"].to_s
  case configuration
  when "Release"
    staging_host = xcconfig_value("Release", "DEV_API_BASE_HOST")
    fail_ipa.call("운영 빌드가 스테이징 API 를 바라봅니다.") if info["API_BASE_HOST"] == staging_host
    fail_ipa.call("운영 빌드의 앱 이름(#{display_name})에 #{STAGING_NAME_MARKER} 가 있습니다.") if display_name.include?(STAGING_NAME_MARKER)
  when "Staging"
    fail_ipa.call("Staging 빌드의 앱 이름(#{display_name})에 #{STAGING_NAME_MARKER} 가 없습니다.") unless display_name.include?(STAGING_NAME_MARKER)
  end

  UI.success("IPA 검증 통과: #{configuration} · #{display_name} · #{info['CFBundleShortVersionString']} (#{info['CFBundleVersion']})")
end

def ipa_info_plist(ipa)
  Dir.mktmpdir do |dir|
    sh("unzip", "-q", "-o", ipa, "Payload/*.app/Info.plist", "-d", dir, log: false)
    plist = Dir[File.join(dir, "Payload", "*.app", "Info.plist")].first
    UI.user_error!("IPA 에서 Info.plist 를 찾지 못했습니다.") unless plist
    JSON.parse(sh("plutil", "-convert", "json", "-o", "-", plist, log: false))
  end
end

def xcconfig_value(configuration, key)
  path = File.expand_path("../Kkobungdan/Secrets.#{configuration}.xcconfig", __dir__)
  UI.user_error!("Secrets.#{configuration}.xcconfig 가 없습니다.") unless File.exist?(path)
  value = File.read(path)[/^\s*#{key}\s*=\s*(.*?)\s*$/, 1]
  UI.user_error!("Secrets.#{configuration}.xcconfig 에 #{key} 가 없습니다.") if value.to_s.empty?
  value
end

def git_output(*args)
  sh("git", *args, log: false, error_callback: ->(_) {}).to_s.strip
end

# ── TestFlight 정보 ───────────────────────────────────────

# 외부 테스트 "테스트할 내용". 직전 태그 이후 커밋 제목을 쓰고, 스테이징 빌드임을 맨 앞에 밝힌다.
def staging_changelog
  commits = changelog_from_git_commits(
    commits_count: 20,
    pretty: "- %s",
    merge_commit_filtering: "exclude_merges",
    quiet: true
  ).to_s.strip
  header = "[STAGING · 스테이징 서버] 테스트용 빌드입니다. 실제 서비스 데이터와 분리되어 있습니다."
  [header, commits].reject(&:empty?).join("\n\n")[0, 4000]
rescue StandardError
  "[STAGING · 스테이징 서버] 테스트용 빌드입니다."
end

# Beta App Review 정보. 환경변수가 있을 때만 덮어쓰고, 없으면 App Store Connect 저장값을 유지한다.
def beta_review_info_options
  info = {
    contact_email: ENV["BETA_CONTACT_EMAIL"],
    contact_first_name: ENV["BETA_CONTACT_FIRST_NAME"],
    contact_last_name: ENV["BETA_CONTACT_LAST_NAME"],
    contact_phone: ENV["BETA_CONTACT_PHONE"],
    demo_account_name: ENV["BETA_DEMO_ACCOUNT_NAME"],
    demo_account_password: ENV["BETA_DEMO_ACCOUNT_PASSWORD"],
    notes: ENV["BETA_REVIEW_NOTES"]
  }.reject { |_, v| v.to_s.empty? }
  return {} if info.empty?

  info[:demo_account_required] = info.key?(:demo_account_name)
  { beta_app_review_info: info }
end

def get_version_string
  project_build_setting("MARKETING_VERSION")
end

# agvtool(VERSIONING_SYSTEM) 을 쓰지 않으므로 pbxproj 에서 직접 읽는다. (모든 구성이 같은 값을 쓴다)
def project_build_setting(key)
  pbxproj = File.read(File.expand_path("../#{PROJECT}/project.pbxproj", __dir__))
  values = pbxproj.scan(/^\s*#{key} = ([^;]+);/).flatten.map(&:strip).uniq
  UI.user_error!("#{key} 를 pbxproj 에서 찾지 못했습니다.") if values.empty?
  UI.user_error!("#{key} 값이 구성마다 다릅니다: #{values.join(', ')}") if values.size > 1
  values.first
end
